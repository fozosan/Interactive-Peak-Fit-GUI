__pycache__/
*.py[cod]

# Local tooling stays off GitHub: Claude Code files and the Code Wiki
# knowledge graph, which graphify regenerates locally.
CLAUDE.md
CLAUDE.local.md
.claude/
graphify-out/

# Build artifact: the docx is compiled from the wiki markdown, never edited
docs/*.docx

# GUI settings are personal: OneDrive syncs them between machines, git never publishes them
ui/ui_config/*.json
